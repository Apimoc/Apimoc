---
interface Props {
  figures: { value: string; label: string }[];
  note?: string;
}

const { figures, note } = Astro.props;

/**
 * The figures are set as a rent-roll strip: one ruled horizontal row with
 * tabular figures and the label beneath the rule, exactly like a line item on
 * a unit schedule.
 *
 * Explicitly NOT three stat cards. No card, no shadow, no border radius, no
 * gradient. On a narrow viewport it stacks to ruled rows, never to cards.
 *
 * The figures belong to one property, so they tell a single story rather than
 * three disconnected claims. The schema caps this at four.
 */
---

{
  figures.length > 0 && (
    <div class="strip-wrap" data-reveal="rows">
      <dl class="strip">
        {figures.map((figure) => (
          <div class="cell">
            <dt class="value t-figure">{figure.value}</dt>
            <dd class="label">{figure.label}</dd>
          </div>
        ))}
      </dl>
      {note && <p class="note">{note}</p>}
    </div>
  )
}

<style>
  .strip-wrap {
    width: 100%;
  }

  .strip {
    margin: 0;
    display: grid;
    /* One row on anything wider than a phone. */
    grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr));
    border-top: var(--hairline) solid var(--rule);
  }

  .cell {
    padding: 0.9rem 0 1rem;
    border-bottom: var(--hairline) solid var(--rule);
    /* Stacked rows on a phone read as a schedule, so the label sits beside
       the figure rather than under it. */
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .value {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink);
  }

  .label {
    margin: 0;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .note {
    margin: 0.9rem 0 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .strip {
      --cols: 4;
      border-bottom: var(--hairline) solid var(--rule);
    }

    .cell {
      /* Columns are separated by a rule, like a ruled schedule. */
      display: block;
      border-bottom: 0;
      padding: 1rem 1.25rem 1.1rem;
      border-left: var(--hairline) solid var(--rule);
    }

    .cell:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .label {
      display: block;
      margin-top: 0.4rem;
    }
  }
</style>
