---
interface Props {
  items: { value: string; label: string; flourish?: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;

/**
 * The trust figures: a large number, a label under it, and a script
 * flourish under that.
 *
 * The number is set in the display face with tabular figures so a row of
 * them lines up, and the flourish is the one place the script face carries
 * meaning rather than decoration: it finishes the sentence the label starts.
 * "Years of Professional" / "experience".
 */
---

{
  items.length > 0 && (
    <dl class:list={["figures", className]} data-reveal="rows">
      {items.map((item) => (
        <div class="figure">
          <dt class="value t-figure">{item.value}</dt>
          <dd class="meta">
            <span class="label">{item.label}</span>
            {item.flourish && (
              <span class="t-script flourish">{item.flourish}</span>
            )}
          </dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .figures {
    margin: 0;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .value {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1;
    color: var(--ink);
  }

  .meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .label {
    font-size: var(--text-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .flourish {
    font-size: 1.5rem;
    margin-top: -0.15rem;
  }

  @media (min-width: 48rem) {
    .figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
