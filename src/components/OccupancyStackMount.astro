---
import { occupancy } from "../content/site";
import { ui } from "../content/ui";
import { lightTokens, darkTokens } from "../lib/tokens";
import OccupancyStackFallback from "./OccupancyStackFallback.astro";

/**
 * Wraps the signature element.
 *
 * The SVG fallback is server-rendered and is what every visitor sees first.
 * The 3D island replaces it only on devices that pass the tier check, and
 * only after the main thread is idle. The label beside it is a stated figure,
 * never an animated counter.
 *
 * Both the canvas and the SVG are hidden from assistive technology; the text
 * equivalent below carries the occupancy story instead.
 */

const palettes = JSON.stringify({ light: lightTokens, dark: darkTokens });
---

<figure class="stack" role="group" aria-labelledby="stack-label">
  <div class="viewport">
    <div class="host" data-stack-host data-palettes={palettes}></div>
    <OccupancyStackFallback />
  </div>

  <figcaption class="label">
    <span class="value t-figure" id="stack-label">{occupancy.label}</span>
    <span class="note">{ui.stack.caption}</span>
  </figcaption>

  {/* The real text equivalent, so the occupancy story reaches a screen
      reader rather than dying inside a canvas. */}
  <p class="sr-only">{occupancy.textEquivalent}</p>
</figure>

<style>
  .stack {
    margin: 0;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }

  .viewport {
    position: relative;
    width: 100%;
    /* A fixed aspect box, portrait because the lattice is a tall stack. The
       canvas and the SVG occupy exactly the same space, so swapping one for
       the other shifts nothing and contributes nothing to CLS. */
    aspect-ratio: 3 / 4;
    max-width: 21rem;
  }

  /* The fallback is a separate component, so it carries its own scope id and
     a bare `.viewport > *` selector would never match it. Astro does not
     extend a parent's scope to a child component's root element. Targeting it
     with :global is what actually stacks the two in the same grid cell. */
  /* Both children are taken out of flow, so neither the SVG's intrinsic
     height nor the canvas wrapper can inflate the box past its aspect ratio.
     In normal flow the taller of the two wins and the ratio is ignored. */
  .viewport > .host,
  .viewport > :global([data-stack-fallback]) {
    position: absolute;
    inset: 0;
  }

  .host {
    /* Sits above the fallback once mounted. */
    z-index: 1;
    pointer-events: none;
  }

  /* React Three Fiber nests the canvas inside its own wrapper divs, which do
     not inherit a height on their own. Without this the canvas measures its
     parent as auto and renders at a fraction of the box. */
  .host > :global(*) {
    width: 100%;
    height: 100%;
  }

  .host :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  :global([data-stack-fallback]) {
    transition: opacity 0.4s var(--ease-out);
  }

  /* Retired only once the 3D island is actually up. */
  :global([data-stack-fallback][data-replaced="true"]) {
    opacity: 0;
    pointer-events: none;
  }

  .label {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    text-align: center;
  }

  .value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .note {
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-stack-fallback] {
      transition: none;
    }
  }
</style>

<script>
  import { mountStack } from "../lib/mount-stack";
  document.addEventListener("astro:page-load", mountStack);
</script>
