---
import { getCollection } from "astro:content";
import { ui } from "../content/ui";
import { formatPeriod, byOrderThenDate } from "../lib/format";

interface Props {
  /** Cap the rows shown, for the condensed version on home. */
  limit?: number;
}

const { limit } = Astro.props;

/**
 * The career spine, set as a rent roll.
 *
 * Dated ruled rows with typed columns for unit count and program type. Not a
 * dotted vertical line with alternating entries: that encodes nothing except
 * "these happened in order", which the dates already say, and it collapses
 * badly on a phone.
 *
 * These columns carry what a regional director actually scans for, and the
 * whole thing stays legible in one pass at 390px.
 */

const all = await getCollection("experience", ({ data }) => !data.draft);
const roles = all.sort(byOrderThenDate).slice(0, limit ?? all.length);
---

{
  roles.length === 0 ? (
    <p class="empty">{ui.career.empty}</p>
  ) : (
    <div class="roll" data-reveal="rows">
      <div class="head" aria-hidden="true">
        <span>{ui.career.colPeriod}</span>
        <span>{ui.career.colRole}</span>
        <span class="num">{ui.career.colUnits}</span>
        <span>{ui.career.colProgram}</span>
      </div>

      {roles.map((role) => (
        <article class="row">
          <span class="period t-figure">
            {formatPeriod(role.data.startDate, role.data.endDate)}
          </span>
          <span class="role">
            <span class="title">{role.data.title}</span>
            <span class="org">{role.data.org}</span>
          </span>
          <span class="units t-figure num">
            {role.data.units ? role.data.units : ""}
          </span>
          <span class="program">{role.data.program.join(", ")}</span>
        </article>
      ))}
    </div>
  )
}

<style>
  .roll {
    border-top: var(--hairline) solid var(--rule);
  }

  .head,
  .row {
    display: grid;
    /* Phone: period and role on one line, units and program beneath. The
       columns stay columns, they just wrap. */
    grid-template-columns: 5.5rem 1fr auto;
    grid-template-areas:
      "period role units"
      ".      prog prog";
    gap: 0.15rem 1rem;
    padding-block: 1rem;
    border-bottom: var(--hairline) solid var(--rule);
    align-items: baseline;
  }

  .head {
    display: none;
  }

  .period {
    grid-area: period;
    color: var(--ink-muted);
    font-size: var(--text-caption);
    white-space: nowrap;
  }

  .role {
    grid-area: role;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .title {
    font-weight: 600;
    color: var(--ink);
  }

  .org {
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  .units {
    grid-area: units;
    color: var(--ink);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .program {
    grid-area: prog;
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  .num {
    text-align: right;
  }

  .empty {
    color: var(--ink-muted);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .head,
    .row {
      grid-template-columns: 7rem 1fr 5rem 14rem;
      grid-template-areas: "period role units prog";
      gap: 1.5rem;
    }

    .head {
      display: grid;
      padding-block: 0.6rem;
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-caption);
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .program {
      text-align: right;
    }
  }
</style>
