---
interface Props {
  name: "trophy" | "clock" | "handshake" | "key" | "shield" | "chart";
  class?: string;
}

const { name, class: className } = Astro.props;

/**
 * The small line icons above the pillar headings.
 *
 * Drawn here as inline SVG rather than pulled from an icon font or a sprite,
 * so they inherit currentColor, cost no extra request, and stay crisp. They
 * are decorative: every one sits directly above its own heading, so they are
 * hidden from assistive technology rather than labelled twice.
 */

const paths: Record<Props["name"], string> = {
  trophy:
    "M7 4h10v5a5 5 0 0 1-10 0V4Zm10 1h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3M12 14v4m-3 2h6",
  clock: "M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z",
  handshake:
    "m9 12 2 2 4-4M3 10l4-4 5 2 5-2 4 4-4 8H7l-4-8Z",
  key: "M14 7a4 4 0 1 1-3.5 5.9L4 19.4V21H2v-2.6l7.1-7.1A4 4 0 0 1 14 7Zm1.5 2.5h.01",
  shield: "M12 3 4 6v6c0 4.5 3.2 8.3 8 9 4.8-.7 8-4.5 8-9V6l-8-3Zm0 8v4",
  chart: "M4 20V10m5 10V4m5 16v-7m5 7V7",
};
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>

<style>
  .icon {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--brass);
    display: block;
  }
</style>
