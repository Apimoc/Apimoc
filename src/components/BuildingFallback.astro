---
interface Props {
  floors: number;
  unitsPerFloor: number;
}

const { floors, unitsPerFloor } = Astro.props;

/**
 * The designed fallback: the same cutaway drawn flat, as an elevation.
 *
 * This is what the server renders, so it is on screen before any JavaScript
 * runs, and it is what a visitor keeps if WebGL is unavailable, reduced
 * motion is set, data saving is on, or the device is weak. It has to look
 * finished on its own, because for a lot of people it is the whole thing.
 */

const UNIT_W = 40;
const UNIT_H = 34;
const SLAB = 4;
const PAD = 10;

const width = unitsPerFloor * UNIT_W + PAD * 2;
const height = floors * UNIT_H + PAD * 2 + 10;

// Same deterministic seeding as the 3D scene, so both show the same building.
const rand = (n: number) => {
  const x = Math.sin(n * 127.1) * 43758.5453;
  return x - Math.floor(x);
};

const units: { x: number; y: number; lit: boolean; number: number }[] = [];
let index = 0;
for (let floor = 0; floor < floors; floor += 1) {
  for (let col = 0; col < unitsPerFloor; col += 1) {
    const bias = 1 - floor / (floors * 1.8);
    units.push({
      x: PAD + col * UNIT_W,
      y: PAD + 10 + (floors - 1 - floor) * UNIT_H,
      lit: rand(index) < 0.78 * bias + 0.12,
      number: (floor + 1) * 100 + (col + 1),
    });
    index += 1;
  }
}
---

<div class="fallback" data-scene-fallback>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-hidden="true"
  >
    {/* Roof */}
    <rect
      x={PAD - 6}
      y={PAD}
      width={width - PAD * 2 + 12}
      height="8"
      class="roof"
    />

    {units.map((unit, i) => (
      <g class:list={["unit", unit.lit && "lit"]} style={`--i:${i}`}>
        <rect
          x={unit.x}
          y={unit.y}
          width={UNIT_W - 3}
          height={UNIT_H - SLAB}
          class="room"
        />
        <text
          x={unit.x + (UNIT_W - 3) / 2}
          y={unit.y + (UNIT_H - SLAB) / 2}
          class="num"
        >
          {unit.number}
        </text>
      </g>
    ))}

    {/* Exposed floor slabs, the thing that makes it read as a cutaway. */}
    {
      Array.from({ length: floors + 1 }).map((_, i) => (
        <rect
          x={PAD - 4}
          y={PAD + 10 + i * UNIT_H - SLAB}
          width={width - PAD * 2 + 8}
          height={SLAB}
          class="slab"
        />
      ))
    }
  </svg>
</div>

<style>
  .fallback {
    display: grid;
    place-items: center;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .roof,
  .slab {
    fill: var(--umber);
  }

  .room {
    fill: var(--paper-raised);
    stroke: var(--rule);
    stroke-width: 1;
  }

  .unit.lit .room {
    fill: color-mix(in oklab, var(--brass) 26%, var(--paper-raised));
    stroke: var(--brass);
  }

  .num {
    font-family: var(--font-sans);
    font-size: 11px;
    font-variant-numeric: tabular-nums slashed-zero;
    text-anchor: middle;
    dominant-baseline: middle;
    fill: var(--ink-muted);
  }

  .unit.lit .num {
    fill: var(--ink);
  }

  /* Arrives already built, resolving rather than filling, so it never reads
     as a progress bar. */
  @media (prefers-reduced-motion: no-preference) {
    .unit {
      opacity: 0;
      animation: settle 0.5s var(--ease-out) forwards;
      animation-delay: calc(min(var(--i) * 6ms, 620ms));
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .unit {
      opacity: 1;
      animation: none;
    }
  }
</style>
