---
import { nav, features, identity } from "../content/site";
import { ui } from "../content/ui";
import ThemeToggle from "./ThemeToggle.astro";

/**
 * Persistent header: logotype left, navigation centered, controls right.
 * Condenses on scroll. The mobile menu traps focus and is fully keyboard
 * operable, including Escape to close and focus restored to the button that
 * opened it.
 */

// A nav entry pointing at a switched-off route is removed rather than
// rendered as a dead link.
const items = nav.filter((item) =>
  item.href === "/blog" ? features.blog : true,
);

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="site-header" id="site-header" data-condensed="false">
  <div class="shell bar">
    {/* No aria-label. Its accessible name is its own visible text, which is
        the only way to satisfy SC 2.5.3 here: the wordmark is uppercased by
        CSS, so any label written in sentence case fails the comparison, and
        writing it in caps to match would couple the copy to a style rule.
        The brand name in the banner is a well understood home link. */}
    <a href="/" class="logotype">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M3 11 12 4l9 7v9H3v-9Z" stroke-linejoin="round" />
          <path d="M10 20v-5h4v5" />
        </svg>
      </span>
      <span class="wordmark">
        <span class="brand">{identity.brand}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={ui.siteNavLabel}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="controls">
      {features.consultation && (
        <a class="btn header-cta" href="/consultation">{ui.header.cta}</a>
      )}
      <ThemeToggle />
      <button
        type="button"
        id="menu-button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={ui.header.openMenu}
        data-label-close={ui.header.closeMenu}
        aria-label={ui.header.openMenu}
      >
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div
    class="mobile-menu"
    id="mobile-menu"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label={ui.header.menuLabel}
  >
    <nav aria-label={ui.header.menuLabel}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {features.consultation && (
      <div class="mobile-cta">
        <a class="btn" href="/consultation">{ui.header.cta}</a>
      </div>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--paper-sunken) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--hairline) solid var(--rule);
    padding-top: env(safe-area-inset-top);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Condensing is a padding change on a sticky bar, which moves nothing in
       the document flow and so cannot contribute to CLS. */
    padding-block: 1.1rem;
    transition: padding-block 0.24s var(--ease-out);
  }

  .site-header[data-condensed="true"] .bar {
    padding-block: 0.6rem;
  }

  .logotype {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    /* Allowed to shrink and truncate rather than forcing the document wider.
       Without min-width:0 a flex item refuses to shrink below its content and
       a long name silently gives the page a horizontal scrollbar. */
    min-width: 0;
    flex: 0 1 auto;
  }

  .mark svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--brass);
    display: block;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* A single line now, so it can carry a little more size and tracking than
     it could when a byline sat under it. */
  .brand {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 14;
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .logotype:hover .brand {
    color: var(--brass);
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--ink);
  }

  .desktop-nav a[aria-current="page"] {
    box-shadow: inset 0 -1px 0 0 var(--brass);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Never shrink: these must stay tappable. */
    flex: 0 0 auto;
  }

  .header-cta {
    display: none;
    min-height: 40px;
    padding-inline: 1.15rem;
    font-size: 0.6875rem;
  }

  .menu-button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink);
  }

  .bars,
  .bars::after {
    display: block;
    width: 20px;
    height: 1px;
    background: currentColor;
    transition: transform 0.24s var(--ease-out);
  }

  .bars::after {
    content: "";
    transform: translateY(5px);
  }

  .menu-button[aria-expanded="true"] .bars {
    transform: translateY(0.5px) rotate(45deg);
  }

  .menu-button[aria-expanded="true"] .bars::after {
    transform: translateY(0) rotate(-90deg);
  }

  .mobile-menu {
    border-top: var(--hairline) solid var(--rule);
    background: var(--paper-sunken);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    margin: 0;
    padding: 0.5rem var(--gutter) 0.5rem;
    list-style: none;
  }

  .mobile-menu li + li {
    border-top: var(--hairline) solid var(--rule);
  }

  /* Scoped to the nav list, not to every anchor in the menu. As
     `.mobile-menu a` this beat `.btn` on specificity and repainted the
     consultation button's text with --ink on brass, at 1.84:1. */
  .mobile-menu nav a {
    display: block;
    padding: 0.95rem 0;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-menu nav a[aria-current="page"] {
    color: var(--brass);
  }

  .mobile-cta {
    padding: 0.5rem var(--gutter) calc(1.5rem + env(safe-area-inset-bottom));
  }

  .mobile-cta .btn {
    width: 100%;
  }

  @media (min-width: 62rem) {
    .desktop-nav {
      display: block;
    }
    .header-cta {
      display: inline-flex;
    }
    .menu-button {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .bars,
    .bars::after {
      transition: none;
    }
  }
</style>

<script>
  const FOCUSABLE =
    'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  function wireHeader() {
    const header = document.getElementById("site-header");
    const button = document.getElementById(
      "menu-button",
    ) as HTMLButtonElement | null;
    const menu = document.getElementById("mobile-menu");
    if (!header || !button || !menu) return;

    /* Condense on scroll using a sentinel and IntersectionObserver rather
       than a scroll handler, so nothing runs on the main thread mid-scroll. */
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
    document.body.prepend(sentinel);

    const io = new IntersectionObserver(
      ([entry]) => {
        header.dataset.condensed = String(!entry?.isIntersecting);
      },
      { threshold: 0 },
    );
    io.observe(sentinel);

    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      menu.hidden = !next;
      button.setAttribute("aria-expanded", String(next));
      const label = next ? button.dataset.labelClose : button.dataset.labelOpen;
      if (label) button.setAttribute("aria-label", label);
      // Stop the page behind the menu scrolling on touch.
      document.body.style.overflow = next ? "hidden" : "";
      if (next) menu.querySelector<HTMLElement>(FOCUSABLE)?.focus();
      else button.focus();
    };

    button.addEventListener("click", () => setOpen(!open));

    document.addEventListener("keydown", (event) => {
      if (!open) return;
      if (event.key === "Escape") {
        event.preventDefault();
        setOpen(false);
        return;
      }
      if (event.key !== "Tab") return;

      // Trap: cycle within the menu plus the button that controls it.
      const items = [
        button,
        ...Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE)),
      ];
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // A menu left open across a navigation would trap focus on a page that
    // no longer shows it.
    document.addEventListener("astro:before-swap", () => {
      if (open) {
        open = false;
        document.body.style.overflow = "";
      }
      io.disconnect();
      sentinel.remove();
    });
  }

  // astro:page-load fires on the FIRST load as well as after every view
  // transition, so this is the only hook needed. Calling wireHeader() here as
  // well would bind every handler twice.
  document.addEventListener("astro:page-load", wireHeader);
</script>
