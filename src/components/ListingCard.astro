---
import Figure from "./Figure.astro";
import { ui } from "../content/ui";

interface Props {
  listing: {
    id: string;
    data: {
      title: string;
      location: string;
      price: string;
      status: "for-sale" | "pending" | "sold";
      beds?: number;
      baths?: number;
      sqft?: number;
      image?: string;
      imageAlt?: string;
      summary: string;
    };
  };
  loading?: "eager" | "lazy";
  /**
   * Heading level for the card title. Defaults to 3, which is right under a
   * section heading on the landing page. The listings index has no h2 between
   * its h1 and the grid, so it passes 2.
   */
  level?: 2 | 3;
}

const { listing, loading = "lazy", level = 3 } = Astro.props;
const d = listing.data;

const statusLabel = {
  "for-sale": ui.listings.statusForSale,
  pending: ui.listings.statusPending,
  sold: ui.listings.statusSold,
}[d.status];

// Only the figures that exist, so a lot with no bedrooms does not print
// "0 beds".
/* flatMap rather than filter with a type predicate: the array literal infers
   a union of literal label types, which a predicate on a widened Spec cannot
   be assigned to. Returning [] for the absent ones drops them and keeps the
   inferred element type intact. */
const specs = [
  d.beds !== undefined ? { value: String(d.beds), label: ui.listings.bedsLabel } : null,
  d.baths !== undefined ? { value: String(d.baths), label: ui.listings.bathsLabel } : null,
  d.sqft !== undefined
    ? { value: d.sqft.toLocaleString("en-US"), label: ui.listings.sqftLabel }
    : null,
].flatMap((spec) => (spec ? [spec] : []));
---

<article class="card-listing">
  <a class="hit" href={`/listings/${listing.id}`}>
    <div class="media">
      <Figure
        src={d.image ? `listings/${d.image}` : undefined}
        alt={d.imageAlt ?? ""}
        ready={Boolean(d.image)}
        arch
        ratio="4 / 5"
        loading={loading}
        sizes="(min-width: 62rem) 24rem, (min-width: 48rem) 40vw, 100vw"
      />
      <span class:list={["status", d.status]}>{statusLabel}</span>
    </div>

    <div class="body">
      {/* Written out rather than built from `h${level}`: a dynamic tag name is
          a component to Astro, and scoped styles do not reach a component's
          root, so `.title` would silently stop applying. */}
      {level === 2 ? (
        <h2 class="t-h3 title">{d.title}</h2>
      ) : (
        <h3 class="t-h3 title">{d.title}</h3>
      )}
      <p class="location t-caption">{d.location}</p>
      <p class="price t-figure">{d.price}</p>
      {specs.length > 0 && (
        <ul class="specs">
          {specs.map((spec) => (
            <li>
              <span class="t-figure num">{spec.value}</span>
              <span class="spec-label">{spec.label}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </a>
</article>

<style>
  .card-listing {
    height: 100%;
  }

  .hit {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .media {
    position: relative;
  }

  .media :global(.plate) {
    transition: transform 0.5s var(--ease-out);
  }

  .hit:hover .media :global(.plate) {
    transform: scale(1.02);
  }

  .status {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    background: var(--brass);
    color: var(--paper);
  }

  /* Status is carried by the word, not only by the color, so it still reads
     for anyone who cannot separate the two. */
  .status.pending {
    background: var(--paper-raised);
    color: var(--ink);
    border: var(--hairline) solid var(--line-ui);
  }

  .status.sold {
    background: var(--ink);
    color: var(--paper);
  }

  .title {
    margin: 0;
    transition: color 0.18s var(--ease-out);
  }

  .hit:hover .title {
    color: var(--brass);
  }

  .location {
    margin: 0.2rem 0 0;
  }

  .price {
    margin: 0.6rem 0 0;
    font-size: 1.25rem;
    color: var(--brass);
  }

  .specs {
    margin: 0.85rem 0 0;
    padding: 0.85rem 0 0;
    border-top: var(--hairline) solid var(--rule);
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin-top: auto;
  }

  .specs li {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .num {
    font-size: 1rem;
    color: var(--ink);
  }

  .spec-label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .media :global(.plate),
    .title {
      transition: none;
    }
  }
</style>
