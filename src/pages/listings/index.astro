---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import ListingCard from "../../components/ListingCard.astro";
import { ui } from "../../content/ui";

const all = await getCollection("listings", ({ data }) => !data.draft);
const listings = all.sort((a, b) => a.data.order - b.data.order);

// Status filter, driven from the data rather than a hardcoded list, so a
// status with nothing in it never gets a button.
const statuses = [
  { id: "for-sale", label: ui.listings.statusForSale },
  { id: "pending", label: ui.listings.statusPending },
  { id: "sold", label: ui.listings.statusSold },
].filter((s) => listings.some((l) => l.data.status === s.id));
---

<Page
  title={ui.pages.listings.heading}
  eyebrow={ui.pages.listings.eyebrow}
  heading={ui.pages.listings.heading}
  standfirst={ui.pages.listings.standfirst}
>
  <section class="band" aria-label="Listings">
    <div class="shell">
      {listings.length === 0 ? (
        <p class="empty">{ui.listings.empty}</p>
      ) : (
        <>
          {statuses.length > 1 && (
            <div class="filter" role="group" aria-label={ui.blog.filterLabel}>
              <button type="button" class="chip" data-status="*" aria-pressed="true">
                {ui.blog.allTags}
              </button>
              {statuses.map((status) => (
                <button
                  type="button"
                  class="chip"
                  data-status={status.id}
                  aria-pressed="false"
                >
                  {status.label}
                </button>
              ))}
            </div>
          )}

          <div class="grid" data-reveal="rows">
            {listings.map((listing, index) => (
              <div class="cell" data-status={listing.data.status}>
                {/* No section heading stands between the page h1 and this
                    grid, so the card titles are the next level down. */}
                <ListingCard
                  listing={listing}
                  loading={index < 3 ? "eager" : "lazy"}
                  level={2}
                />
              </div>
            ))}
          </div>

          <p class="none" hidden data-empty-filtered>
            {ui.listings.empty}
          </p>
        </>
      )}
    </div>
  </section>
</Page>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
    justify-content: center;
  }

  .chip {
    background: none;
    border: var(--hairline) solid var(--rule);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    min-height: 40px;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-muted);
    transition:
      color 0.18s var(--ease-out),
      border-color 0.18s var(--ease-out);
  }

  .chip[aria-pressed="true"] {
    color: var(--paper);
    background: var(--brass);
    border-color: var(--brass);
  }

  .grid {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }

  .cell[hidden] {
    display: none;
  }

  .empty,
  .none {
    margin: 0;
    color: var(--ink-muted);
    text-align: center;
  }

  .none[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }
</style>

<script>
  function wireFilter() {
    const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
    const cells = document.querySelectorAll<HTMLElement>(".cell[data-status]");
    const none = document.querySelector<HTMLElement>("[data-empty-filtered]");
    if (!chips.length) return;

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const want = chip.dataset.status ?? "*";
        chips.forEach((other) =>
          other.setAttribute("aria-pressed", String(other === chip)),
        );

        let shown = 0;
        cells.forEach((cell) => {
          const show = want === "*" || cell.dataset.status === want;
          cell.hidden = !show;
          if (show) shown += 1;
        });

        if (none) none.hidden = shown > 0;
      });
    });
  }

  // astro:page-load fires on the first load as well as after every view
  // transition, so this is the only hook needed.
  document.addEventListener("astro:page-load", wireFilter);
</script>
