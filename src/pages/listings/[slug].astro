---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import EmailLink from "../../components/EmailLink.astro";
import { ui, fill } from "../../content/ui";
import { identity, contact, isPlaceholder } from "../../content/site";

export const getStaticPaths = (async () => {
  const items = await getCollection("listings", ({ data }) => !data.draft);
  const sorted = items.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((item, index) => ({
    params: { slug: item.id },
    props: {
      item,
      previous: index > 0 ? sorted[index - 1] : undefined,
      next: index < sorted.length - 1 ? sorted[index + 1] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

const { item, previous, next } = Astro.props;
const { Content } = await render(item);
const d = item.data;

const statusLabel = {
  "for-sale": ui.listings.statusForSale,
  pending: ui.listings.statusPending,
  sold: ui.listings.statusSold,
}[d.status];

// See the note in ListingCard.astro on why this is flatMap and not filter.
const specs = [
  { value: d.price, label: ui.listings.priceLabel },
  d.beds !== undefined ? { value: String(d.beds), label: ui.listings.bedsLabel } : null,
  d.baths !== undefined ? { value: String(d.baths), label: ui.listings.bathsLabel } : null,
  d.sqft !== undefined
    ? { value: d.sqft.toLocaleString("en-US"), label: ui.listings.sqftLabel }
    : null,
].flatMap((spec) => (spec ? [spec] : []));

const shortName = isPlaceholder(identity.shortName) ? "" : identity.shortName;
const hasEmail = !isPlaceholder(contact.emailUser);
---

<Base title={d.title} description={d.summary}>
  <article class="listing">
    <div class="shell">
      <p class="back">
        <a href="/listings">{ui.cta.backToListings}</a>
      </p>

      <header class="head">
        <div class="head-copy">
          <p class="t-caption status-line">
            <span class:list={["status", d.status]}>{statusLabel}</span>
            <span class="loc">{d.location}</span>
          </p>
          <h1 class="t-h2 title" data-reveal="lines">{d.title}</h1>
          <p class="summary" data-reveal="block">{d.summary}</p>
        </div>

        <div class="head-photo" data-reveal="block">
          <Figure
            src={d.image ? `listings/${d.image}` : undefined}
            alt={d.imageAlt ?? ""}
            ready={Boolean(d.image)}
            arch
            ratio="4 / 5"
            loading="eager"
            sizes="(min-width: 62rem) 28rem, 80vw"
          />
        </div>
      </header>

      <dl class="specs" aria-label={ui.listings.detailsHeading}>
        {specs.map((spec) => (
          <div>
            <dt class="t-figure spec-value">{spec.value}</dt>
            <dd class="spec-label">{spec.label}</dd>
          </div>
        ))}
      </dl>

      <div class="detail">
        <div class="narrative" data-reveal="block">
          <Content />
        </div>

        {/* A div, not an aside. These features are part of the listing, not
            tangential to it, and an aside here would nest a complementary
            landmark inside main for no navigational gain. The h2 already puts
            it in the heading outline. */}
        {d.features.length > 0 && (
          <div class="features card">
            <h2 class="t-h3 features-title">{ui.listings.featuresHeading}</h2>
            <ul>
              {d.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <section class="enquire card">
        <h2 class="t-h3">{ui.listings.enquireHeading}</h2>
        <p>{ui.listings.enquireBody}</p>
        <div class="enquire-actions">
          <a class="btn" href="/contact">{ui.cta.getInTouch}</a>
          {hasEmail && (
            <EmailLink
              class="btn btn-ghost"
              label={fill(ui.cta.emailMe, { NAME: shortName }).trim()}
            />
          )}
        </div>
      </section>

      <nav class="pager" aria-label={ui.cta.backToListings}>
        {previous ? (
          <a href={`/listings/${previous.id}`} rel="prev">{ui.cta.previous}</a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={`/listings/${next.id}`} rel="next" class="next">
            {ui.cta.next}
          </a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .listing {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }

  .back {
    margin: 0 0 2rem;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
  }

  .back a {
    text-decoration: none;
  }

  .back a::before {
    content: "← ";
  }

  .head {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  .status-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .status {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--brass);
    color: var(--paper);
    font-weight: 600;
  }

  .status.pending {
    background: var(--paper-raised);
    color: var(--ink);
    border: var(--hairline) solid var(--line-ui);
  }

  .status.sold {
    background: var(--ink);
    color: var(--paper);
  }

  .title {
    text-transform: none;
  }

  .summary {
    margin: 1rem 0 0;
    color: var(--ink-muted);
    max-width: 46ch;
    font-size: 1.0625rem;
  }

  .head-photo {
    max-width: 28rem;
    width: 100%;
    justify-self: center;
  }

  .specs {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    border-top: var(--hairline) solid var(--rule);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .specs > div {
    padding: 1.15rem 1.25rem;
    border-left: var(--hairline) solid var(--rule);
  }

  .specs > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .spec-value {
    font-size: 1.375rem;
    color: var(--ink);
  }

  .spec-label {
    margin: 0.3rem 0 0;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .detail {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .narrative :global(p) {
    margin: 0 0 1.15rem;
    max-width: 60ch;
    color: var(--ink-muted);
  }

  .features-title {
    text-transform: none;
    margin-bottom: 1rem;
  }

  .features ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .features li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.75rem;
    height: 1px;
    background: var(--brass);
  }

  .enquire {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    text-align: center;
  }

  .enquire h2 {
    text-transform: none;
  }

  .enquire p {
    margin: 0.75rem auto 0;
    max-width: 46ch;
    color: var(--ink-muted);
  }

  .enquire-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.75rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: var(--hairline) solid var(--rule);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
  }

  .pager a {
    text-decoration: none;
  }

  .next {
    margin-left: auto;
  }

  @media (min-width: 62rem) {
    .head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .head-photo {
      justify-self: end;
    }
    .detail {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    }
  }
</style>
