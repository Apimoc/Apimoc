---
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";
import { ui } from "../content/ui";

const all = await getCollection("credentials", ({ data }) => !data.draft);
const sorted = all.sort((a, b) => a.data.order - b.data.order);

const certs = await Promise.all(
  sorted
    .filter((entry) => entry.data.kind === "credential")
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const systems = sorted.filter((entry) => entry.data.kind === "system");

const title = "Credentials";
---

<Page
  title={title}
  heading={title}
  description="Designations, certifications and the systems I work in."
>
  <section class="band" aria-label={title}>
    <div class="shell">
      {certs.length === 0 && systems.length === 0 && (
        <p class="empty">{ui.credentials.empty}</p>
      )}

      {certs.length > 0 && (
        <div class="list" data-reveal="rows">
          {certs.map(({ entry, Content }) => (
            <article class="entry">
              <div class="head">
                <h2 class="t-h3">{entry.data.name}</h2>
                <p class="meta t-figure">
                  {entry.data.issuer}
                  {entry.data.issuer && entry.data.year ? " · " : ""}
                  {entry.data.year}
                </p>
              </div>
              <div class="body measure">
                <Content />
              </div>
            </article>
          ))}
        </div>
      )}

      {systems.length > 0 && (
        <div class="systems">
          <h2 class="t-caption">{ui.credentials.systemsHeading}</h2>
          <ul class="system-list" data-reveal="rows">
            {systems.map((entry) => (
              <li>{entry.data.name}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Page>

<style>
  .list {
    border-top: var(--hairline) solid var(--rule);
  }

  .entry {
    padding-block: 1.5rem;
    border-bottom: var(--hairline) solid var(--rule);
    display: grid;
    gap: 0.5rem;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .head h2 {
    margin: 0;
  }

  .meta {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  .body {
    color: var(--ink-muted);
  }

  .body :global(p) {
    margin: 0;
  }

  .systems {
    margin-top: 3.5rem;
  }

  .system-list {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline) solid var(--rule);
  }

  .system-list li {
    padding-block: 0.85rem;
    border-bottom: var(--hairline) solid var(--rule);
  }

  .empty {
    color: var(--ink-muted);
    margin: 0;
  }
</style>
