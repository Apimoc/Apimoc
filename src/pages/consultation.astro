---
import Page from "../layouts/Page.astro";
import ContactForm from "../components/ContactForm.astro";
import { ui } from "../content/ui";
---

<Page
  title={ui.pages.consultation.heading}
  eyebrow={ui.pages.consultation.eyebrow}
  heading={ui.pages.consultation.heading}
  standfirst={ui.pages.consultation.standfirst}
>
  <section class="band" aria-label={ui.consultation.stepsHeading}>
    <div class="shell">
      <ol class="steps" data-reveal="rows">
        {ui.consultation.steps.map((step, index) => (
          <li class="step">
            <span class="num t-figure" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h2 class="t-h3 step-title">{step.title}</h2>
            <p class="step-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band-raised" aria-label={ui.contact.formHeading}>
    <div class="shell form-wrap">
      <ContactForm consultation />
    </div>
  </section>
</Page>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .num {
    font-size: 1.75rem;
    color: var(--brass);
    line-height: 1;
  }

  .step-title {
    text-transform: none;
    font-size: 1.25rem;
  }

  .step-body {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }

  .form-wrap {
    max-width: 42rem;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
