---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Band from "../components/Band.astro";
import RentRollStrip from "../components/RentRollStrip.astro";
import CareerSpine from "../components/CareerSpine.astro";
import CaseStudyList from "../components/CaseStudyList.astro";
import BuildingMount from "../components/BuildingMount.astro";
import EmailLink from "../components/EmailLink.astro";
import Portrait from "../components/Portrait.astro";
import { activeHomeSections } from "../content/theme";
import { identity, assets, contact, isPlaceholder } from "../content/site";
import { ui, fill } from "../content/ui";

/**
 * The landing page introduces her. It is not a stat sheet: the unit counts,
 * the rent roll and the dated career rows all live on /experience, where
 * someone has already decided to look properly.
 *
 * Sections come from the array in src/content/theme.ts. Reorder that array
 * and this page reorders; disable an entry and it disappears without leaving
 * a gap, because every band owns its own spacing and rule.
 */

const sections = await getCollection("home");
const bySection = new Map(sections.map((entry) => [entry.data.section, entry]));

const hero = bySection.get("hero");
const rentRoll = bySection.get("rentRoll");
const aboutEntry = bySection.get("about");
const contactEntry = bySection.get("contact");

const AboutBody = aboutEntry ? (await render(aboutEntry)).Content : null;
const ContactBody = contactEntry ? (await render(contactEntry)).Content : null;

const ctaName = isPlaceholder(identity.shortName) ? "" : identity.shortName;
const hasEmail = !isPlaceholder(contact.emailUser);
---

<Base>
  {
    activeHomeSections.map((section) => {
      switch (section.id) {
        /* ---------------------------------------------------------------
           HERO
           The building sits behind the type rather than beside it, so the
           first thing on screen is a piece of architecture. The LCP element
           is still the headline text, never the canvas.
           --------------------------------------------------------------- */
        case "hero":
          return (
            <section class="hero" aria-label={hero?.data.headline ?? undefined}>
              <div class="hero-scene">
                <BuildingMount scene="home" size="hero" />
              </div>

              <div class="shell hero-copy">
                <h1 class="t-display headline" data-reveal="lines">
                  {hero?.data.headline}
                </h1>
                {hero?.data.standfirst && (
                  <p class="standfirst" data-reveal="block">
                    {hero.data.standfirst}
                  </p>
                )}

                <div class="cta" data-reveal="block">
                  {hasEmail && (
                    <EmailLink
                      class="button primary"
                      label={fill(ui.cta.email, { NAME: ctaName }).trim()}
                    />
                  )}
                  <a class="button" href="/experience">{ui.cta.fullCv}</a>
                </div>
              </div>
            </section>
          );

        case "rentRoll":
          return (
            <Band label={ui.rentRoll.regionLabel}>
              <RentRollStrip
                figures={rentRoll?.data.figures ?? []}
                note={rentRoll?.data.figuresNote}
              />
            </Band>
          );

        case "careerSpine":
          return (
            <Band heading={section.heading}>
              <CareerSpine limit={3} />
              <p class="more">
                <a href="/experience">{ui.cta.fullCv}</a>
              </p>
            </Band>
          );

        case "caseStudies":
          return (
            <Band heading={section.heading}>
              <CaseStudyList limit={3} />
              <p class="more">
                <a href="/work">{ui.cta.allCaseStudies}</a>
              </p>
            </Band>
          );

        case "about":
          return (
            <Band heading={section.heading}>
              <div class="about">
                <Portrait />
                <div class="about-copy measure" data-reveal="block">
                  {AboutBody && <AboutBody />}
                  <p class="more">
                    <a href="/about">{ui.cta.moreAbout}</a>
                  </p>
                </div>
              </div>
            </Band>
          );

        case "contact":
          return (
            <Band heading={section.heading}>
              <div class="measure" data-reveal="block">
                {ContactBody && <ContactBody />}
                <p class="more">
                  <a href="/contact">{fill(ui.cta.email, { NAME: ctaName }).trim()}</a>
                </p>
              </div>
            </Band>
          );

        default:
          return null;
      }
    })
  }
</Base>

<style>
  /* The scene and the copy share one grid cell, so the type sits over the
     architecture without either being positioned absolutely against the
     other. */
  .hero {
    display: grid;
    align-items: center;
    padding-block: clamp(1rem, 4vw, 3rem) clamp(2rem, 6vw, 4rem);
  }

  /* On a phone the two stack: copy first, then the building. Overlaying a
     headline on a moving building is unreadable at 390px and no amount of
     scrim fixes it. From tablet up they become side-by-side columns. */
  .hero {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 2.5rem);
  }

  .hero-copy {
    order: 1;
  }

  .hero-scene {
    order: 2;
    width: 100%;
  }

  /* Only the actual controls take pointer events back, so the building never
     eats a click or a swipe. */
  .hero-copy :global(a) {
    pointer-events: auto;
  }

  .headline {
    max-width: 16ch;
  }

  .standfirst {
    margin: 1.75rem 0 0;
    max-width: 34ch;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Ruled rectangles, consistent with everything else. No radius, no shadow,
     no gradient. */
  .cta :global(.button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1.4rem;
    border: var(--hairline) solid var(--line-ui);
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
    backdrop-filter: blur(4px);
    transition:
      background-color 0.18s var(--ease-out),
      color 0.18s var(--ease-out);
  }

  .cta :global(.button.primary) {
    background: var(--brass);
    border-color: var(--brass);
    color: var(--paper);
  }

  .cta :global(.button:hover) {
    opacity: 1;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .about {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .about-copy :global(p) {
    margin: 0 0 1.15rem;
  }

  .more {
    margin: 1.5rem 0 0;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
  }

  .more :global(a) {
    text-decoration: none;
    pointer-events: auto;
  }

  .more :global(a::after) {
    content: " →";
  }

  @media (min-width: 48rem) {
    .about {
      grid-template-columns: 14rem 1fr;
      gap: 3rem;
    }

    /* Two real columns. The type never crosses the building. */
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(1rem, 4vw, 3rem);
    }

    .hero-copy {
      grid-area: 1 / 1;
    }

    .hero-scene {
      grid-area: 1 / 2;
      justify-self: stretch;
    }

    .headline {
      max-width: 14ch;
    }
  }
</style>
