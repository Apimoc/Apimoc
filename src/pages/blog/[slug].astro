---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { features, siteUrl, identity, isPlaceholder } from "../../content/site";
import { ui } from "../../content/ui";
import { formatDateLong, isoDate } from "../../lib/format";
import "../../styles/prose.css";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: index > 0 ? sorted[index - 1] : undefined,
      older: index < sorted.length - 1 ? sorted[index + 1] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const articleSchema = JSON.stringify({
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate(post.data.pubDate),
  ...(post.data.updatedDate
    ? { dateModified: isoDate(post.data.updatedDate) }
    : {}),
  mainEntityOfPage: new URL(`/blog/${post.id}`, siteUrl).href,
  ...(isPlaceholder(identity.fullName)
    ? {}
    : { author: { "@type": "Person", name: identity.fullName } }),
  keywords: post.data.tags.join(", "),
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  prose
  noindex={!features.blog}
  articleSchema={articleSchema}
>
  <article class="post">
    <div class="shell">
      <p class="back">
        <a href="/journal">{ui.cta.backToBlog}</a>
      </p>

      <p class="t-caption meta">
        <time datetime={isoDate(post.data.pubDate)}>
          {formatDateLong(post.data.pubDate)}
        </time>
        {post.data.tags.length > 0 && ui.blog.metaSeparator}
        {post.data.tags.join(", ")}
      </p>

      <h1 class="t-h2 title" data-reveal="lines">{post.data.title}</h1>

      <div class="prose body" data-reveal="block">
        <Content />
      </div>

      <nav class="pager" aria-label={ui.cta.backToBlog}>
        {older ? (
          <a href={`/blog/${older.id}`} rel="prev">{ui.cta.previous}</a>
        ) : (
          <span></span>
        )}
        {newer && (
          <a href={`/blog/${newer.id}`} rel="next" class="next">
            {ui.cta.next}
          </a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .post {
    padding-block: clamp(2rem, 6vw, 3.5rem) 0;
  }

  .back {
    margin: 0 0 2.5rem;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
  }

  .back a {
    text-decoration: none;
  }

  .back a::before {
    content: "← ";
  }

  /* A brass hairline under the date line, above the title. */
  .meta {
    margin: 0 0 1rem;
    padding-bottom: 1rem;
    border-bottom: var(--hairline) solid var(--brass);
    max-width: var(--measure);
  }

  .title {
    max-width: 20ch;
  }

  .body {
    margin-top: 2.5rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: var(--hairline) solid var(--rule);
    max-width: var(--measure);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
  }

  .pager a {
    text-decoration: none;
  }

  .next {
    margin-left: auto;
  }
</style>
