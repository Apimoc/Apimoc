---
import Page from "../layouts/Page.astro";
import ContactForm from "../components/ContactForm.astro";
import EmailLink from "../components/EmailLink.astro";
import { contact, identity, isPlaceholder } from "../content/site";
import { ui } from "../content/ui";

const hasPhone = !isPlaceholder(contact.phone);
const hasEmail = !isPlaceholder(contact.emailUser);
const hasOffice = !isPlaceholder(contact.office);
const socials = [
  { href: contact.linkedin, label: ui.footer.linkedinLabel },
  { href: contact.instagram, label: ui.footer.instagramLabel },
  { href: contact.facebook, label: ui.footer.facebookLabel },
].filter((s) => !isPlaceholder(s.href));
---

<Page
  title="Contact"
  description={ui.pages.contact.description}
  eyebrow={ui.pages.contact.eyebrow}
  heading={ui.pages.contact.heading}
  standfirst={ui.pages.contact.standfirst}
>
  <section class="band" aria-label={ui.contact.formHeading}>
    <div class="shell layout">
      <ContactForm />

      {/* A div, not an aside. The direct contact details are a second way to
          do the thing this page is for, not content tangential to it, so a
          complementary landmark nested inside main would mislead. */}
      <div class="direct">
        <h2 class="t-h3 direct-title">{ui.contact.directHeading}</h2>
        <ul class="rows">
          {hasEmail && (
            <li>
              <span class="t-caption">{ui.footer.emailLabel}</span>
              <EmailLink />
            </li>
          )}
          {hasPhone && (
            <li>
              <span class="t-caption">{ui.footer.phoneLabel}</span>
              <a href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}>
                {contact.phone}
              </a>
            </li>
          )}
          {hasOffice && (
            <li>
              <span class="t-caption">{ui.footer.officeLabel}</span>
              <span>{contact.office}</span>
            </li>
          )}
          {/* Only when there is no street address, so the two do not both
              appear under an "Office" heading saying different things. */}
          {!hasOffice && (
            <li>
              <span class="t-caption">{ui.footer.basedLabel}</span>
              <span>{identity.location}</span>
            </li>
          )}
        </ul>

        {socials.length > 0 && (
          <nav class="socials" aria-label={ui.socialNavLabel}>
            {socials.map((social) => (
              <a href={social.href} rel="me noopener noreferrer" target="_blank">
                {social.label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </div>
  </section>
</Page>

<style>
  .layout {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .direct-title {
    text-transform: none;
    margin-bottom: 1.25rem;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline) solid var(--rule);
  }

  .rows li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-block: 1rem;
    border-bottom: var(--hairline) solid var(--rule);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.75rem;
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    font-weight: 500;
  }

  .socials a {
    text-decoration: none;
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    }
  }
</style>
