---
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";
import { ui } from "../content/ui";

const all = await getCollection("services", ({ data }) => !data.draft);
const services = all.sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  services.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<Page
  title={ui.pages.services.heading}
  eyebrow={ui.pages.services.eyebrow}
  heading={ui.pages.services.heading}
  standfirst={ui.pages.services.standfirst}
>
  <section class="band" aria-label="Services">
    <div class="shell">
      {rendered.length === 0 ? (
        <p class="empty">{ui.services.empty}</p>
      ) : (
        <ol class="services">
          {rendered.map(({ entry, Content }, index) => (
            <li class="service" data-reveal="block">
              <div class="marker" aria-hidden="true">
                <span class="num t-figure">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <Icon name={entry.data.icon} />
              </div>
              <div class="detail">
                <h2 class="t-h3 title">{entry.data.title}</h2>
                <p class="summary">{entry.data.summary}</p>
                <div class="body"><Content /></div>
                {entry.data.points.length > 0 && (
                  <ul class="points">
                    {entry.data.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      )}

      <p class="center-cta">
        <a class="btn" href="/consultation">{ui.cta.bookConsultation}</a>
      </p>
    </div>
  </section>
</Page>

<style>
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .service {
    display: grid;
    gap: 1rem 2rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: var(--hairline) solid var(--rule);
  }

  .service:last-child {
    border-bottom: var(--hairline) solid var(--rule);
  }

  .marker {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .num {
    font-size: 1.5rem;
    color: var(--brass);
    line-height: 1;
  }

  .title {
    margin: 0;
    text-transform: none;
    font-size: 1.625rem;
  }

  .summary {
    margin: 0.5rem 0 0;
    color: var(--ink);
    max-width: 52ch;
  }

  .body :global(p) {
    margin: 1rem 0 0;
    color: var(--ink-muted);
    max-width: 56ch;
    font-size: 0.9375rem;
  }

  .points {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: 56ch;
  }

  .points li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  /* A brass rule rather than a bullet glyph, matching the hairlines used
     everywhere else. */
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.75rem;
    height: 1px;
    background: var(--brass);
  }

  .center-cta {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    text-align: center;
  }

  .empty {
    margin: 0;
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .service {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
    .marker {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
