---
import Base from "./Base.astro";
import BuildingMount from "../components/BuildingMount.astro";
import type { SceneName } from "../content/scenes";

interface Props {
  title: string;
  description?: string;
  /** The large display line at the top of the page. */
  heading: string;
  /** Optional line under the heading. */
  standfirst?: string;
  prose?: boolean;
  noindex?: boolean;
  /** Which building this page shows. See src/content/scenes.ts. */
  scene?: SceneName;
}

const { title, description, heading, standfirst, prose, noindex, scene } =
  Astro.props;
---

<Base title={title} description={description} prose={prose} noindex={noindex}>
  <header class="page-head">
    {scene && (
      <div class="page-scene">
        <BuildingMount scene={scene} size="banner" />
      </div>
    )}
    <div class="shell head-copy">
      <h1 class="t-display" data-reveal="lines">{heading}</h1>
      {standfirst && (
        <p class="standfirst measure" data-reveal="block">{standfirst}</p>
      )}
    </div>
  </header>
  <slot />
</Base>

<style>
  .page-head {
    display: grid;
    align-items: center;
    padding-block: clamp(1.5rem, 5vw, 3rem) clamp(2rem, 5vw, 3rem);
  }

  .page-head {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .head-copy {
    order: 1;
  }

  .page-scene {
    order: 2;
    width: 100%;
  }

  .head-copy :global(a) {
    pointer-events: auto;
  }

  @media (min-width: 48rem) {
    .page-head {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 2rem;
    }

    .head-copy {
      grid-area: 1 / 1;
    }

    .page-scene {
      grid-area: 1 / 2;
      justify-self: stretch;
    }
  }

  .page-head h1 {
    max-width: 20ch;
  }

  .standfirst {
    margin: 1.5rem 0 0;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }
</style>
