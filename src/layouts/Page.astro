---
import Base from "./Base.astro";
import SectionHead from "../components/SectionHead.astro";

interface Props {
  title: string;
  description?: string;
  /** The script flourish above the heading. */
  eyebrow?: string;
  /** The large display line at the top of the page. */
  heading: string;
  standfirst?: string;
  prose?: boolean;
  noindex?: boolean;
}

const { title, description, eyebrow, heading, standfirst, prose, noindex } =
  Astro.props;
---

<Base title={title} description={description} prose={prose} noindex={noindex}>
  <header class="page-head">
    <div class="shell">
      <SectionHead
        eyebrow={eyebrow}
        heading={heading}
        standfirst={standfirst}
        level="h1"
        align="center"
        class="page-head-inner"
      />
    </div>
  </header>
  <slot />
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 7vw, 5.5rem) 0;
    background: var(--paper-sunken);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .page-head :global(.page-head-inner) {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
</style>
