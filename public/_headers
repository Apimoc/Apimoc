# Cloudflare Pages headers.
#
# The Content Security Policy is NOT here: Astro generates it per page,
# including the hash of every inline script, and injects it as a meta element.
# Duplicating it here would mean maintaining a second copy that silently
# drifts out of date the moment a script changes.

/*
  # frame-ancestors only works as a real header, never via a meta element,
  # so this one directive lives here while the rest of the policy is
  # generated per page by Astro.
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fonts are content-addressed by name and never change in place. If a font is
# ever swapped, change the file name too.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Astro fingerprints everything under _astro, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
