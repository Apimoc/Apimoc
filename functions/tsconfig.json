{
  // Cloudflare Pages Functions run in the Workers runtime, not the browser.
  // Their types are scoped to this folder deliberately: pulling
  // @cloudflare/workers-types into the site's program replaces the DOM
  // globals, and things like document.body.prepend stop type-checking.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"]
  },
  "include": ["**/*.ts"]
}
