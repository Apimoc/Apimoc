# Copy to .env for local development.
#
# In production these are set in the Cloudflare Pages dashboard under
# Settings -> Environment variables, NOT in a file. Never commit real values.
#
# Only PUBLIC_TURNSTILE_SITE_KEY is sent to the browser. Everything else is
# read inside the Pages Function and never leaves the server.

# Cloudflare Turnstile. The site key is public by design; it belongs in the
# page. The secret key is not.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend. The sending domain must be verified first.
RESEND_API_KEY=
CONTACT_FROM=site@yourdomain.com
CONTACT_TO=you@yourdomain.com
